{
  "rewrites": [
    { "source": "/Amazon-Design.html", "destination": "/api/serve-page?page=Amazon-Design.html" },
    { "source": "/AZURECICD.html", "destination": "/api/serve-page?page=AZURECICD.html" },
    { "source": "/AZURECICD - Copy.html", "destination": "/api/serve-page?page=AZURECICD - Copy.html" },
    { "source": "/C#Dotnet.html", "destination": "/api/serve-page?page=C#Dotnet.html" },
    { "source": "/DSA.html", "destination": "/api/serve-page?page=DSA.html" },
    { "source": "/C%23Dotnet.html", "destination": "/api/serve-page?page=C#Dotnet.html" },
    { "source": "/How AI work.html", "destination": "/api/serve-page?page=How AI work.html" },
    { "source": "/Project.html", "destination": "/api/serve-page?page=Project.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "no-referrer" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), clipboard-read=(), clipboard-write=()" }
      ]
    }
  ]
}
